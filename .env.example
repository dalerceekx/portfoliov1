# Copy to .env before running docker compose.
# Generate every secret with: openssl rand -base64 48

# ---- Database ----------------------------------------------------------------
# Keep this as-is to run the bundled Postgres container. To use Amazon RDS
# instead, set COMPOSE_PROFILES to an empty value and set DATABASE_URL below.
COMPOSE_PROFILES=bundled-db
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=portfolio

# Only for RDS (or any external Postgres). Leave commented out otherwise —
# when it is set, the bundled db container is ignored entirely.
# DATABASE_URL=postgresql://portfolio:PASSWORD@db.abc123.eu-central-1.rds.amazonaws.com:5432/portfolio?schema=public&sslmode=require

# ---- Auth --------------------------------------------------------------------
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string_at_least_32_chars

# ---- Site --------------------------------------------------------------------
# The URL the site is actually served from. Drives CORS, canonical URLs and the
# session cookie flags, so it must match the address in the browser's bar.
PUBLIC_SITE_URL=http://localhost:8081

# Port published on the host. Use 80 on a server, 443 is handled by the ALB.
WEB_PORT=8081

# Must be true whenever PUBLIC_SITE_URL is https — the API refuses to boot on a
# mismatch, because the browser would silently discard the session cookie.
COOKIE_SECURE=false

# How many reverse proxies sit in front of the API:
#   1  the bundled Nginx only (a plain EC2 instance)
#   2  an ALB or CloudFront terminating TLS ahead of Nginx
# Set this too low and every visitor shares the proxy's IP, which collapses the
# per-IP rate limits into one site-wide bucket — five bad logins from anyone
# would then lock you out of your own admin panel.
TRUST_PROXY_HOPS=1

# ---- Seed admin --------------------------------------------------------------
# Used once, by `docker compose exec api npm run seed:prod`. Seeding refuses to
# run with the values shipped here, so pick your own. At least 12 characters,
# with an uppercase letter, a number and a symbol. No '#' — dotenv reads
# everything after one as a comment.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
