# ---- Server ----
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173

# ---- Database ----
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5432/portfolio?schema=public

# ---- Auth (generate: openssl rand -base64 48) ----
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string_at_least_32_chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_DOMAIN=
COOKIE_SECURE=false

# ---- Seed admin ----
# `npm run seed` creates this account and then leaves it alone, so changing the
# password here later has no effect. Use `npm run admin:password` to rotate it.
# Do not put a '#' in the value: dotenv reads everything after it as a comment.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Ch4nge-Me-Now!2026

# ---- Proxies -----------------------------------------------------------------
# Reverse proxies between the client and this process: 1 for the bundled Nginx,
# 2 when an ALB or CloudFront terminates TLS in front of it. 0 when running
# `npm run dev` with nothing in front. Rate limiting reads the client IP through
# this, so a wrong value turns the per-IP limits into one shared bucket.
TRUST_PROXY_HOPS=0

# ---- Uploads ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=3145728
