# Standalone TLS — only for a box that holds its own certificate.
#
# On AWS the simpler path is an ALB (or CloudFront) with an ACM certificate:
# ACM renews automatically, nothing private ever lands on the instance, and
# default.conf already works behind it unchanged. Use this file instead when
# there is no load balancer and Certbot issues the certificate on the host.
#
#   1. Issue the certificate on the host:
#        sudo certbot certonly --standalone -d example.com
#   2. Mount it into the web container, in docker-compose.yml:
#        web:
#          volumes:
#            - /etc/letsencrypt:/etc/letsencrypt:ro
#            - ./web/nginx/tls.conf.example:/etc/nginx/conf.d/default.conf:ro
#          ports:
#            - '80:80'
#            - '443:443'
#   3. Set PUBLIC_SITE_URL=https://example.com and COOKIE_SECURE=true in .env.
#
# Renewal: `certbot renew` writes new files but cannot reload Nginx inside the
# container, so pair it with `docker compose exec web nginx -s reload` in the
# deploy hook.

map $http_x_forwarded_proto $forwarded_proto {
  ''      $scheme;
  default $http_x_forwarded_proto;
}

map $forwarded_proto $hsts_value {
  https   'max-age=31536000; includeSubDomains';
  default '';
}

upstream api_upstream {
  server api:4000;
  keepalive 16;
}

# Everything on port 80 is redirected, except the ACME challenge Certbot serves.
server {
  listen 80;
  server_name example.com www.example.com;
  server_tokens off;

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl;
  http2 on;
  server_name example.com www.example.com;
  server_tokens off;

  ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;

  root /usr/share/nginx/html;
  index index.html;

  client_max_body_size 4m;

  gzip on;
  gzip_vary on;
  gzip_min_length 1024;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml application/xml;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  location /assets/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control 'public, max-age=31536000, immutable' always;
    try_files $uri =404;
  }

  location = /index.html {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control 'no-cache' always;
  }

  location /api/ {
    proxy_pass http://api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_set_header Connection '';
    proxy_read_timeout 30s;
  }

  location /uploads/ {
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header Cache-Control;
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control 'public, max-age=2592000, immutable' always;
    proxy_pass http://api_upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
  }

  location / {
    include /etc/nginx/snippets/security-headers.conf;
    try_files $uri $uri/ /index.html;
  }
}
