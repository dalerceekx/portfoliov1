# Production template — an EC2 instance behind an Application Load Balancer that
# terminates TLS with an ACM certificate. Copy to .env on the server and fill in.
#
# Generate each secret separately:  openssl rand -base64 48

# ---- Database ----------------------------------------------------------------
# Bundled Postgres on the instance's EBS volume. Cheapest, and fine for one box,
# but the data lives and dies with that volume — pair it with deploy/backup.sh.
COMPOSE_PROFILES=bundled-db
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=
POSTGRES_DB=portfolio

# For Amazon RDS instead: blank out COMPOSE_PROFILES above, uncomment this, and
# let RDS handle backups, patching and failover.
# COMPOSE_PROFILES=
# DATABASE_URL=postgresql://portfolio:PASSWORD@db.abc123.eu-central-1.rds.amazonaws.com:5432/portfolio?schema=public&sslmode=require

# ---- Auth --------------------------------------------------------------------
JWT_ACCESS_SECRET=

# ---- Site --------------------------------------------------------------------
PUBLIC_SITE_URL=https://example.com
WEB_PORT=80
COOKIE_SECURE=true

# 2 because the ALB forwards to Nginx, which forwards to the API.
TRUST_PROXY_HOPS=2

# ---- Seed admin --------------------------------------------------------------
# Delete both lines once the account exists; they are read only by the seed.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
